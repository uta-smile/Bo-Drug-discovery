# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Environments / secrets ---
.venv/
venv/
env/
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Oracle model weights (~71 MB) ---
# TDC downloads these on first tdc.Oracle(...) call. Never commit.
oracle/
*.pkl

# --- Regenerable caches -------------------------------------------------
# Regenerable caches and the legacy experiment caches listed below stay out
# of the clone; curated inputs used by the manuscript remain tracked.

# Morgan fingerprint matrices, rebuilt from SMILES by RDKit in seconds (~15 MB)
data/cache/*.npz

# TDC's raw ZINC dump, auto-downloaded on first use (~12 MB)
data/cache/tdc/

# Legacy LLM and PMO prompt caches are not part of the RECOMB paper.
data/cache/llm/
data/cache/llm_init/
data/cache/llm_init_pmo/
data/cache/llm_pmo/
data/cache/llm_select/
data/cache/llm_only/
data/cache/pmo/llm/
data/cache/pmo/llm_init/
data/cache/pmo/llm_policy/
data/cache/pmo/llm_select/
data/cache/pmo/llm_only/

# Legacy PMO, Boltz-2, and LLM campaign outputs and entry-point tools.
/data/cache/boltz2.sqlite
/results/crossed_auxiliary_v1/smoke_initial_validation/
/scripts/boltz2_headroom.py
/scripts/build_report.py
/scripts/clm_collect.py
/scripts/clm_probe.py
/scripts/clm_train.py
/scripts/constraint_headroom.py
/scripts/pmo_ground_truth.py
/scripts/run_lookup_experiment.py
/scripts/run_pmo_experiment.py
/tests/test_boltz2.py
/tests/test_pmo.py
/results_chembl203.log
/results_pmo.log

# --- Scratch ---
scratch/
tmp/
*.log
!results/**/*.log
# ...except raw inference-server logs, which are noise and huge (qwen: 10 MB).
results/*_server.log

# Exclude legacy experiment outputs after the general results log exception.
/results/pmo/
/results/pmo_constraint/
/results/pmo_ladder/
/results/pmo_ladder_llm/
/results/pmo_warmstart/
/results/pmo_ground_truth.json
/results/pmo_ladder.log
/results/pmo_ladder_llm.log
/results/boltz2_*
/results/bench_*/
/results/chembl203_agentic_b50/
/results/chembl203_ladder_b50/
/results/report.html
/results/ladder_report.html


# CLM selector (scripts/clm_*.py). Shortlists are regenerated by clm_collect.py
# in minutes (~90 MB); embeddings by the frozen encoder (~1 h, ~300 MB); heads
# by clm_train.py. The heads' .json report next to each .pt IS committed.
data/clm/*.jsonl
data/clm/*.pt
data/cache/clm/

# graphify knowledge graph (graphify extract . --code-only). Machine-local;
# force-add graphify-out/graph.json if you want to share it.
graphify-out/

# Docking: the Vina binary (1.2 MB, download it) and its per-molecule score
# cache. Regenerated by scripts/dock_library.py; the .meta.json next to each
# cache IS committed, since it records the redocking validation.
tools/
data/cache/docking/*.pdb
data/cache/docking/*.pdbqt
data/cache/docking/*.box.*
data/cache/docking/*.jsonl
data/cache/tdc/

# Learned region prior: the BindingDB-derived training corpus (centroid
# fingerprints + sequences) and ESM2 embeddings. Rebuilt by
# scripts/build_prior_data.py in ~15 min; the .meta.json IS committed.
data/prior/*.npz
data/prior/*.pt
data/cache/esm/
data/cache/sweep_libs/

# --- DOCKSTRING (95 MB TSV + QED cache) -------------------------------
# 260,148 ligands x 58 docking targets. Redownload with:
#   curl -sSL -o data/dockstring/dockstring-dataset.tsv \
#     https://api.figshare.com/v2/file/download/35948138
# (the figshare.com/ndownloader URL the Mobley notebook uses now returns 0
# bytes behind an AWS WAF challenge; the api host is not challenged.)
data/dockstring/*.tsv
data/dockstring/*.npy

# Built by scripts/build_evidence.py; regenerate rather than commit.
evidence/
evidence.zip

# Local Boltz-2 scratch workspaces.
data/cache/boltz2_work/
# SQLite journal sidecars: transient, meaningless outside a live process.
*.sqlite-shm
*.sqlite-wal

# --- LaTeX build artifacts (report/build.sh compiles in place) ----------
# report/*.log is already covered by the *.log rule above.
*.aux
*.bbl
*.blg
*.toc
*.lof
*.lot
*.synctex.gz
*.fls
*.fdb_latexmk
report/*.out
report/paper.pdf
report/supplement.pdf

# --- Tooling / local state ----------------------------------------------
# .venv-boltz currently hides itself with an internal .gitignore; don't rely
# on that surviving a reinstall.
.venv*/
# Claude Code per-machine settings (hooks/permissions). .claude/settings.json
# IS committed; the .local.json override is not.
.claude/settings.local.json
.claude/shell-snapshots/
.graphify_cache/

# --- Editor / OS leftovers ---
*.swp
*~
*.orig
*.rej

# Local Claude guidance is not part of the shared project.
/CLAUDE.md

# Local Claude Code configuration and skills.
.claude/

# Plain-language explainer of the paper (local only)
report/explain_paper.md

# Editor and manual backups
*.bak
